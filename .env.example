# MercadinhoSys - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores

# ==================== FLASK ====================
FLASK_ENV=production
FLASK_APP=run.py

# ==================== DATABASE ====================
DB_PASSWORD=mercadinho_secure_pass_2024_CHANGE_ME
DATABASE_URL=postgresql://mercadinho_user:mercadinho_secure_pass_2024_CHANGE_ME@postgres:5432/mercadinhosys

# ==================== SECURITY ====================
# IMPORTANTE: Gere chaves seguras em produção! (config.py RECUSA subir em
# FLASK_ENV=production sem SECRET_KEY e JWT_SECRET_KEY definidos.)
# Exemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-CHANGE-IN-PRODUCTION
JWT_SECRET_KEY=your-jwt-secret-key-CHANGE-IN-PRODUCTION

# ==================== CORS ====================
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:80

# ==================== REDIS ====================
REDIS_PASSWORD=redis_secure_pass_CHANGE_ME

# ==================== COSMOS (catálogo por código de barras) ====================
# Token da API Cosmos (Bluesoft) usado ao escanear o código de barras no cadastro.
# Opcional: o sistema tem um token de fallback embutido que já funciona. Defina o
# seu próprio token aqui (ou nas variáveis de ambiente do servidor) para ter quota maior.
COSMOS_TOKEN=

# ==================== EMAIL (Zoho) ====================
# Senha de app do Zoho: Minha conta → Segurança → Senhas específicas de app.
MAIL_SERVER=smtp.zoho.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=suporte@maldivastech.dev
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="MercadinhoSys <suporte@maldivastech.dev>"
EMAIL_FROM="MercadinhoSys <suporte@maldivastech.dev>"
MAIL_REPLY_TO=suporte@maldivastech.dev

# ==================== BACKUP ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Diariamente às 2h da manhã

# ==================== MONITORING (Opcional) ====================
SENTRY_DSN=
LOG_LEVEL=INFO
