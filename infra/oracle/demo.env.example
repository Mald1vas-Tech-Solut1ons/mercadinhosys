# Copie para infra/oracle/.env.demo no servidor. Nao envie valores secretos ao chat.
# Gere tres valores independentes com: openssl rand -hex 32
# Use hexadecimal para DB_PASSWORD (evita caracteres reservados na URL).
DB_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=
# Endereco HTTPS real do frontend, sem barra final.
CORS_ORIGINS=
# Integrações opcionais; manter valores reais apenas no .env.demo protegido.
DEEPSEEK_API=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=1024
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CLOUDINARY_URL=
EFI_CLIENT_ID_HOMOL=
EFI_CLIENT_SECRET_HOMOL=
EFI_CLIENT_ID_PROD=
EFI_CLIENT_SECRET_PROD=
EFI_PIX_KEY=
EFI_ENV=sandbox
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
